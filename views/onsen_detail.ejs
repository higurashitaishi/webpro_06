<!Doctype html>

<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>
  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>所在地</td><td><%= data.place %></td></tr>
    <tr><td>温泉名</td><td><%= data.name %></td></tr>
    <tr><td>温度</td><td><%= data.degree %></td></tr>
  </table>
  <br>
  <a href="/onsen/edit/<%= id %>">編集</a>
  <a href="/onsen">温泉一覧に戻る</a>
</body>
</html>