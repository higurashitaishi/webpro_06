<!Doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>京葉線の駅</title>
</head>
<body>
  <h2>京葉線の駅の詳細</h2>
  
  <table>
  <tr>
    <th>駅名</th> <th>操作</th>
  </tr>
  <% let number = 0 %>
  <% for( let row of data ) { %>
    <tr>
      <td>
        <a href="/keiyo2/<%= number %>"><%= row.name %></a>
      </td>
      <td>
        <a href="/keiyo2/confirm_delete/<%= number %>">削除</a>
      </td>
    </tr>
    <% number += 1 %>
  <% } %>
</table>

  <a href="/keiyo2/create">新規駅を追加</a>
</body>
</html>