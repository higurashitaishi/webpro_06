<!Doctype html>

<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>
  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>所属チーム</td><td><%= data.team %></td></tr>
    <tr><td>ポジション</td><td><%= data.position %></td></tr>
    <tr><td>背番号</td><td><%= data.num %></td></tr>
    <tr><td>名前</td><td><%= data.name %></td></tr>
  </table>
  <br>
  <a href="/baseball/edit/<%= id %>">編集</a>
  <a href="/baseball">野球選手一覧に戻る</a>
</body>
</html>