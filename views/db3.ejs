<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>千葉県のラーメン屋</title>
</head>
<body>
  <h2>千葉県のラーメン屋</h2>
  <table>
    <tr><th>ID</th><th>場所</th><th>店名</th></tr>
      <% for( let row of data ) { %>
        <tr><td><%= row.id %></td>
        <td><%= row.code %></td>
        <td><%= row.name %></td></tr>
      <% } %>
  </table>
</body>
</html>