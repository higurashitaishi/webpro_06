<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>千葉県のラーメン屋</title>
</head>
<body>
  <h2>千葉県のラーメン屋</h2>
  <table>
    <tr><th>ID</th><th>場所</th><th>店名</th></tr>
      <% for( let row of data ) { %>
        <tr><td><%= row.id %></td>
        <td><%= row.code %></td>
        <td><%= row.name %></td></tr>
      <% } %>
  </table>
  <form action="/ramen_add">
        <label for="id">ID</label>
        <input type="number" name="id" id="id" required>

        <label for="code">場所</label>
        <input type="text" name="code" id="code" required>

        <label for="name">店名</label>
        <input type="text" name="name" id="name" required>

        <input type="submit" values="登録">
    </form>
</body>
</html>