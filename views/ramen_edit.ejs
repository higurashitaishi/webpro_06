<!Doctype html>

<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の編集</h2>
  <form action="/ramen/update/<%= data.id - 1 %>" method="POST">
    <input type="hidden" name="id" value="<%= data.id %>">
    
    <table>
      <tr><th>項目</th><th>データ</th></tr>
      <tr><td>最寄駅</td><td><input type="text" name="moyori" value="<%= data.moyori %>"></td></tr>
      <tr><td>店名</td><td><input type="text" name="name" value="<%= data.name %>"></td></tr>
      <tr><td>おすすめ商品</td><td><input type="text" name="choice" value="<%= data.choice %>"></td></tr>
    </table>
    <input type="submit" value="登録"> </form>
  <a href="/ramen/">ラーメン屋一覧に戻る</a>
</body>
</html>